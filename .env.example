# --- Next.js (apps/web/.env.local) ---
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
# 단축 링크 리다이렉터 → Convex clicks.record 호출용 공유 시크릿 (Convex 환경변수와 동일 값)
REDIRECT_SHARED_SECRET=change-me

# --- Convex 배포 환경변수 (npx convex env set KEY value) ---
# 공개 인터넷에서 접근 가능한 HTTPS 웹 주소. localhost·사설 IP를 운영값으로 쓰지 마세요. HTTP·자격증명 포함 URL은 거부됩니다.
# SITE_URL=https://app.example.com
# 라이브 게시의 기본값은 off. 운영에서는 명시적인 true만 사용합니다(파서는 1/yes/on도 활성값으로 인식).
# LIVE_PUBLISH_ENABLED=false
# JWT_PRIVATE_KEY / JWKS : npx @convex-dev/auth 로 생성
# SUPER_ADMIN_EMAILS=owner@example.com,second@example.com
# KYC_ENC_KEY=<base64 32 bytes>  (openssl rand -base64 32)
# REDIRECT_SHARED_SECRET=change-me
# ATTRANGS_WEBHOOK_SECRET=<아뜨랑스와 공유하는 HMAC 시크릿>
# ATTRANGS_MODE=mock            # mock=클릭 데모 전용(실제 정산 불가), pool=검증된 파트너 링크 CSV 풀

# --- M3: 텔레그램 봇 (Convex env) ---
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_BOT_USERNAME=automoney_bot
# TELEGRAM_WEBHOOK_SECRET=<setWebhook 의 secret_token 과 동일>
# publish protocol v2(account identity/JIT preflight/canonical receipt)를 지원하는 최소 버전
# MIN_DESKTOP_VERSION=0.1.13

# --- M4: 큐레이션 검색 프로바이더 (Convex env, 선택) ---
# BRAVE_API_KEY=            # 있으면 연예인 착용 검색에 Brave Search 사용
# SERPAPI_KEY=              # 또는 SerpAPI (Brave 우선)

# --- M5: Meta API (Convex env) ---
# META_MODE=mock                 # mock | graph (기본: 앱 자격증명 있으면 graph)
# META_APP_ID=
# META_APP_SECRET=
# META_REDIRECT_URI=https://<deployment>.convex.site/meta/callback
# META_TOKEN_ENC_KEY=            # base64 32B (없으면 KYC_ENC_KEY 사용)
# ANALYTICS_MIN_SAMPLES=20       # 플레이북 승격 최소 표본
# E2E_TEST_HOOKS=0               # 1 이면 analytics.tickNow 의 now 인자 허용(E2E 전용)

# --- 데스크톱 에이전트 (환경변수 또는 ~/.automoney/config.json) ---
# AUTOMONEY_CONVEX_SITE_URL=https://<deployment>.convex.site
# AUTOMONEY_SITE_URL=https://app.example.com
# AUTOMONEY_BROWSER_CHANNEL=chrome        # 시스템 Chrome 사용
# AUTOMONEY_HEADLESS=0
# AUTOMONEY_AUTOPILOT=1                    # 레시피 실패 시 Codex 오토파일럿 복구
# AUTOMONEY_AUTOPILOT_PLANNER=codex|scripted|off
# AUTOMONEY_CODEX_MODEL=                   # codex exec -m
# AUTOMONEY_CONTENT_PROVIDER=codex|template # 콘텐츠 생성 제공자(기본 codex, 실패 시 template 폴백)
# AUTOMONEY_DRY_RUN=1                    # 로컬 비상 안전장치. live payload는 성공으로 위장하지 않고 LOCAL_DRY_RUN_OVERRIDE로 중단
# AUTOMONEY_READBACK_URL=                  # (테스트) readback 이 열 게시물 URL 오버라이드
# AUTOMONEY_UPDATE_FEED_URL=              # 비우면 GitHub Releases 피드, https URL 이면 사설 generic 피드, off 면 비활성
