{
  "name": "automoney",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @automoney/web dev",
    "build": "pnpm --filter @automoney/shared build && pnpm -r --filter '!@automoney/shared' build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "postinstall": "pnpm --filter @automoney/shared build"
  }
}
