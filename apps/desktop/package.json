{
  "name": "@automoney/desktop",
  "version": "0.1.1",
  "private": true,
  "description": "automoney 데스크톱 에이전트 — 브라우저 스페이스·SNS 포스팅·Codex 실행",
  "author": "automoney",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "electron .",
    "agent": "node dist/cli.js",
    "test": "vitest run",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "@automoney/shared": "workspace:*",
    "convex": "^1.45.0",
    "playwright": "^1.63.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^22",
    "electron": "^44.2.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "kr.automoney.desktop",
    "productName": "automoney",
    "artifactName": "automoney-agent-${version}-${os}-${arch}.${ext}",
    "protocols": [
      {
        "name": "automoney",
        "schemes": [
          "automoney"
        ]
      }
    ],
    "files": [
      "dist/**",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "contentscoin",
        "repo": "automoney",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "directories": {
      "output": "release"
    }
  }
}
